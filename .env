# =============================================================================
#  Senarath Bank HR lab - environment settings
# =============================================================================
#  LOG_DIR = the directory on the HOST (the Ubuntu laptop) where all portal
#  logs are written: app.log, apache_access.log, apache_error.log.
#
#  To relocate the logs:
#    1. change LOG_DIR below
#    2. create it and make it writable:  sudo mkdir -p <new path> && sudo chmod 777 <new path>
#    3. rebuild:                          docker compose up -d --build
# =============================================================================

LOG_DIR=/var/log/senarath
